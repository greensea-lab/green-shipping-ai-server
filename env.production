# Production Environment Configuration (Remote MySQL)
# 프로덕션 환경 설정

# Database Configuration (Remote MySQL)
DATABASE_URL=mysql+pymysql://prod_user:prod_password@prod-mysql-host:3306/green_shipping_prod

# Security
SECRET_KEY=production-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# MySQL Configuration (Production)
MYSQL_HOST=prod-mysql-host
MYSQL_PORT=3306
MYSQL_USER=prod_user
MYSQL_PASSWORD=prod_password
MYSQL_DATABASE=green_shipping_prod

# Environment
ENVIRONMENT=production 