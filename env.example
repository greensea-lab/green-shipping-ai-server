# EC2 + Docker Compose 배포용 환경 변수 예시
# 사용법: cp env.example .env (EC2에서 실행)

# ===== Database (Docker Compose) =====
DATABASE_URL=mysql+pymysql://green_user:green_password@db:3306/green_shipping_db

# ===== Security (반드시 변경!) =====
SECRET_KEY=your-secret-key-here-change-this
INTERNAL_API_TOKEN=your-internal-token-here-change-this

# ===== Server =====
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# ===== AI / LLM (선택) =====
OPENAI_API_KEY=sk-proj-your-openai-key
AI_MODEL=gpt-4
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=1000
EMBEDDING_MODEL=text-embedding-3-small

# ===== RAG / Knowledge Base =====
RAG_PERSIST_DIR=/app/data/chroma

# ===== MySQL Container (docker-compose.yml과 일치) =====
MYSQL_ROOT_PASSWORD=root_password_change_this
MYSQL_DATABASE=green_shipping_db
MYSQL_USER=green_user
MYSQL_PASSWORD=green_password_change_this

# ===== Port Database (선택) =====
PORT_DB_CSV_PATH=/app/models/data/Port_DB.csv
PORT_DB_ENCODING=utf-8