# Development Environment Configuration (Remote MySQL)
# 개발 환경 설정

# Database Configuration (Remote MySQL)
DATABASE_URL=mysql+pymysql://dev_user:dev_password@dev-mysql-host:3306/green_shipping_dev

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# MySQL Configuration (Development)
MYSQL_HOST=dev-mysql-host
MYSQL_PORT=3306
MYSQL_USER=dev_user
MYSQL_PASSWORD=dev_password
MYSQL_DATABASE=green_shipping_dev

# Environment
ENVIRONMENT=development 