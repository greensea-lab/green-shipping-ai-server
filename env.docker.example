# Docker Compose 로컬 개발용 환경 변수 템플릿
# 사용법: cp env.docker.example .env

# ===== Database (Docker MySQL 사용) =====
# docker-compose.yml의 db 서비스와 동일한 값으로 설정
DATABASE_URL=mysql+pymysql://green_user:green_password@db:3306/green_shipping_db

# ===== Security =====
SECRET_KEY=dev-secret-key-change-in-production
INTERNAL_API_TOKEN=dev-internal-token

# ===== Server =====
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# ===== AI / LLM (선택 사항) =====
# OpenAI API 키가 없어도 기본 답변으로 작동합니다
OPENAI_API_KEY=

# AI 설정
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=1000
EMBEDDING_MODEL=text-embedding-3-small

# ===== RAG / Knowledge Base =====
RAG_PERSIST_DIR=./data/chroma

# ===== Port Database (선택 사항) =====
PORT_DB_CSV_PATH=app/models/data/Port_DB.csv

# ===== MySQL Container Settings (docker-compose.yml과 동기화) =====
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=green_shipping_db
MYSQL_USER=green_user
MYSQL_PASSWORD=green_password
